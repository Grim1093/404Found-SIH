# ==============================================
# VoxGuard Environment Variables
# ==============================================
# Copy this file to .env and fill in the values

# --- Database (Aiven PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://avnadmin:AVNS_QX5HiKHmKYPVczSMpUc@pg-327e8968-grimllre-0a0a.k.aivencloud.com:23004/defaultdb
DATABASE_SSL=true

# --- Redis / Valkey (Aiven) ---
# REDIS_URL=rediss://user:password@host:port

# --- JWT Authentication ---
JWT_SECRET=voxguard-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8001

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- App ---
APP_NAME=VoxGuard API
DEBUG=true

# --- ML Model Config ---
MODEL_PATH=models/best_checkpoint.pt
WAV2VEC_MODEL_NAME=facebook/wav2vec2-base
DEVICE=auto
SAMPLE_RATE=16000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
