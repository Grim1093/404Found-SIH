# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
.next/
out/
dist/
build/
*.egg-info/

# ML model weights (large files)
ml-service/models/*.pt
ml-service/models/*.pth
ml-service/models/*.bin
ml-service/models/*.safetensors
