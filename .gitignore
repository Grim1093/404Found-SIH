# Audio files (privacy — never commit raw audio)
*.wav
*.mp3
*.flac
*.ogg
!frontend/public/sounds/

# Spectrogram outputs
ml-service/tmp/spectrograms/

# Docker
*.log

# Alembic
backend/alembic/versions/*.pyc

